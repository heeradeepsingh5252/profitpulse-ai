POSTGRES_DB=profitpulse
POSTGRES_ADMIN_USER=profitpulse_admin
POSTGRES_ADMIN_PASSWORD=local_admin_password_change_me
APP_DB_PASSWORD=local_app_password_change_me
DATABASE_URL=postgresql://profitpulse_app:local_app_password_change_me@db:5432/profitpulse
DEMO_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111

# Day 3 LLM configuration. Keep API keys private; never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Day 4 knowledge retrieval and MCP (local development)
CHROMA_PATH=/app/data/chroma
RAG_MAX_UPLOAD_BYTES=10485760
MCP_API_BASE_URL=http://api:8000
MCP_HOST=0.0.0.0
MCP_PORT=8001
